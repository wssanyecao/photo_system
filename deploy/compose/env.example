# 安全默认值：先仅监听宿主机回环；现场验证后再改为 宿主机的内网地址。
PHOTO_BIND_IP=127.0.0.1
PHOTO_PORT=18080
PHOTO_PLATFORM=linux/amd64
PHOTO_UID=1000
PHOTO_GID=1000
PHOTO_IMAGE_TAG=stable
PHOTO_STORAGE_ROOT=/srv/photo-gateway/storage
PHOTO_CONFIG_PATH=/srv/photo-gateway/config.yaml
PHOTO_NAS_KEY_PATH=/srv/photo-gateway/secrets/nas_key
PHOTO_KNOWN_HOSTS_PATH=/srv/photo-gateway/secrets/known_hosts

# 构建源（均可按现场网络覆盖）
PYTHON_IMAGE=python:3.12-slim-bookworm
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
