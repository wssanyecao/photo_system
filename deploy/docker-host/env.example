# 安全默认值：先仅监听宿主机回环；现场验证后再改为 docker-host 的内网地址。
PHOTO_BIND_IP=127.0.0.1
PHOTO_PORT=18080
PHOTO_UID=1000
PHOTO_GID=1000
PHOTO_IMAGE_TAG=stable
PHOTO_STORAGE_ROOT=/data/compose/photo-system/storage
PHOTO_CONFIG_PATH=/data/compose/photo-system/config/config.yaml
PHOTO_NAS_KEY_PATH=/data/compose/photo-system/secrets/nas_key
PHOTO_KNOWN_HOSTS_PATH=/data/compose/photo-system/secrets/known_hosts

# 构建源（均可按现场网络覆盖）
PYTHON_IMAGE=python:3.12-slim-bookworm
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
